{
  "name": "gymroul",
  "version": "1.0.0",
  "description": "GymRoulette: ruleta de ejercicios (web + Android con Capacitor)",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p jsconfig.json",

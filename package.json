{
  "name": "gymroul",
  "version": "1.10.0",
  "versionCode": 10,
  "versionCodename": "Warm-up",
  "description": "GymRoulette: ruleta de ejercicios (web + Android con Capacitor)",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-legal.mjs && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "cap:sync": "cap sync android",
    "deploy": "npm run build && firebase deploy --only hosting",
    "build:android": "npm run build && npm run cap:sync",
    "icons": "node scripts/build-icons.mjs && capacitor-assets generate --android",
    "store": "npm run build && node scripts/build-store-assets.mjs && node scripts/build-release-notes.mjs && node scripts/build-listing-csv.mjs",
    "legal": "node scripts/build-legal.mjs",
    "release-notes": "node scripts/build-release-notes.mjs && node scripts/build-listing-csv.mjs"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind": "^1.2.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.5": true
  }
}

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Tema base de la app. AppTheme.NoActionBar hereda de él y, desde Android 9, añade el recorte de pantalla y el contraste de las barras
         (values-v28, v29 y v30): la pantalla completa se hace a mano, sin enableEdgeToEdge de androidx.activity, que llama a APIs obsoletas en Android 15 -->
    <style name="Base.AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Fondo de la ventana (franjas bajo las barras del sistema): el de la app (claro u oscuro según el modo del sistema), no el gris del tema -->
        <item name="android:windowBackground">@color/gym_background</item>
        <!-- Con la pantalla completa (MainActivity) las barras son transparentes y se ve el fondo de la app. Son atributos del tema, no llamadas a Window.setStatusBarColor ni setNavigationBarColor (obsoletas en Android 15) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Base.AppTheme.NoActionBar" />


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Sin ActionBar también aquí (con los atributos del framework, android:, porque el padre es un tema del framework, y con los de AppCompat por si acaso): MainActivity activa la pantalla completa antes de que BridgeActivity cambie a AppTheme.NoActionBar,
             y la ventana construye su decoración con este tema. Si trae ActionBar, empuja la web 56 dp hacia abajo (visto en Android 17) -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12 y posteriores ignoran el fondo anterior y pintan el icono de la app: sin esto salía el logo oscuro sobre el fondo claro -->
        <item name="windowSplashScreenBackground">@color/gym_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>